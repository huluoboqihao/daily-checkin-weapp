/* ────────────────────────────────────────────────
   设计基调：iOS 式中性色 + 单一品牌强调色。
   背景 F2F2F7、卡片纯白、分隔线 12% 墨色；
   层级靠字号与留白，不靠投影。
   ──────────────────────────────────────────────── */
page {
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: calc(32rpx * var(--fs));
  line-height: 1.45;
  /* 字号缩放基准；.font-lg / .font-xl 只改这个变量 */
  --fs: 1;
}

.font-lg { --fs: 1.08; }
.font-xl { --fs: 1.16; }

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  position: relative;
}

/* 全屏背景墙：fixed 铺满，内容浮在上面 */
.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}

/* 分组标题：小号、字距、次要色 */
.sec {
  display: flex;
  align-items: baseline;
  margin: 44rpx 8rpx 14rpx;
}
.sec-title {
  font-size: calc(26rpx * var(--fs));
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #8E8E93;
}
.sec-more {
  margin-left: auto;
  font-size: calc(24rpx * var(--fs));
  color: #8E8E93;
}

/* 卡片：白底、大圆角、无投影 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

/* 大标题 */
.h1 {
  font-size: calc(68rpx * var(--fs));
  font-weight: 700;
  letter-spacing: -1rpx;
  color: #1C1C1E;
}
.h1-sub {
  margin-top: 6rpx;
  font-size: calc(26rpx * var(--fs));
  color: #8E8E93;
}

.ph {
  color: #C7C7CC;
}

/* ───────────── 动效（接近 iOS 的克制节奏）───────────── */

@keyframes rise {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pop {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.anim-rise {
  animation: rise 0.34s cubic-bezier(0.22, 0.8, 0.28, 1) both;
}
.anim-pop {
  animation: pop 0.26s ease both;
}
.anim-fade {
  animation: fade 0.3s ease both;
}
.delay-1 { animation-delay: 0.04s; }
.delay-2 { animation-delay: 0.08s; }
.delay-3 { animation-delay: 0.12s; }

.tap-scale {
  transition: transform 0.12s ease;
}
.tap-scale:active {
  transform: scale(0.985);
}

/* ───────────── 深色模式 ─────────────
   只覆盖承载内容的表面与文字；强调色保持不变。
   页面级细节在各页 wxss 末尾补齐。 */
.theme-dark {
  background: #000000;
  color: #F2F2F7;
}
.theme-dark .page-bg {
  opacity: 0.14;
}
.theme-dark .card,
.theme-dark .hero,
.theme-dark .summary,
.theme-dark .item,
.theme-dark .cell,
.theme-dark .draft,
.theme-dark .task,
.theme-dark .habit,
.theme-dark .week,
.theme-dark .ach,
.theme-dark .empty,
.theme-dark .import-row,
.theme-dark .ai-bar {
  background: #1C1C1E;
}
.theme-dark .sec-title,
.theme-dark .sec-more {
  color: #8E8E93;
}
.theme-dark .h1,
.theme-dark .h1-sub {
  color: #F2F2F7;
}
.theme-dark .ph {
  color: #636366;
}
