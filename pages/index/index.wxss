.page {
  padding: 0 28rpx 40rpx;
}

/* 顶部进度 */
.hero {
  padding: 44rpx 8rpx 34rpx;
}
.hero-date {
  font-size: calc(24rpx * var(--fs));
  color: #a89e8f;
  letter-spacing: 2rpx;
}
.hero-mid {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
}
.prog-n {
  font-size: calc(84rpx * var(--fs));
  font-weight: 700;
  color: #e8674a;
  line-height: 1;
}
.prog-t {
  font-size: calc(32rpx * var(--fs));
  color: #c4b8a6;
  margin-left: 6rpx;
}
.prog-l {
  margin-left: auto;
  font-size: calc(23rpx * var(--fs));
  color: #a89e8f;
}
.bar {
  margin-top: 26rpx;
  height: 14rpx;
  background: #efe8dd;
  border-radius: 7rpx;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  background: #e8674a;
  border-radius: 7rpx;
  transition: width 0.25s ease;
}

/* 累计统计 */
.cum {
  margin-top: 24rpx;
  font-size: calc(22rpx * var(--fs));
  color: #a89e8f;
}
.cum-n {
  font-size: calc(26rpx * var(--fs));
  font-weight: 700;
  color: #221d18;
}
.cum-dot {
  margin: 0 12rpx;
  color: #d8cfc0;
}
.cum-note {
  margin-top: 10rpx;
  font-size: calc(19rpx * var(--fs));
  color: #c4b8a6;
}

/* 本周条 */
.week {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 20rpx;
}
.wk {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wk-d {
  font-size: calc(20rpx * var(--fs));
  color: #b8ad9d;
}
.wk-c {
  margin-top: 12rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #efe8dd;
}
.wk-c.on {
  background: #f0b8a6;
}
/* 全勤那天加深——一天做了几件和一件不落地做完，值得分开看 */
.wk-c.full {
  background: #e8674a;
}
.wk-c.today {
  box-shadow: 0 0 0 5rpx rgba(232, 103, 74, 0.18);
}

/* 成就 */
.ach-row {
  display: flex;
  flex-wrap: wrap;
}
.badge {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 8rpx;
}
.badge-i {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff1ea;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(36rpx * var(--fs));
}
.badge-n {
  margin-top: 10rpx;
  font-size: calc(19rpx * var(--fs));
  color: #a89e8f;
  text-align: center;
}
.badge.more .badge-i {
  background: #f2ede4;
  font-size: calc(24rpx * var(--fs));
  color: #a89e8f;
}

.ach-none {
  font-size: calc(23rpx * var(--fs));
  color: #a89e8f;
  padding: 6rpx 0 4rpx;
}

.next {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f2ece1;
}
.next-top {
  display: flex;
  align-items: baseline;
}
.next-i {
  font-size: calc(30rpx * var(--fs));
}
.next-n {
  margin-left: 12rpx;
  font-size: calc(27rpx * var(--fs));
  font-weight: 600;
  color: #221d18;
}
.next-p {
  margin-left: auto;
  font-size: calc(24rpx * var(--fs));
  color: #e8674a;
  font-weight: 700;
}
.next-bar {
  margin-top: 14rpx;
  height: 12rpx;
  background: #efe8dd;
  border-radius: 6rpx;
  overflow: hidden;
}
.next-in {
  height: 100%;
  background: #e8674a;
  border-radius: 6rpx;
  transition: width 0.25s ease;
}
.next-d {
  margin-top: 12rpx;
  font-size: calc(20rpx * var(--fs));
  color: #b8ad9d;
}
.next-done {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2ece1;
  font-size: calc(22rpx * var(--fs));
  color: #a89e8f;
  text-align: center;
}

/* 习惯卡 */
.list {
  margin-top: 10rpx;
}
.habit {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 100, 70, 0.06);
  transition: transform 0.12s ease;
}
.habit.done {
  background: #fff5f1;
}
.h-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(40rpx * var(--fs));
  color: #ffffff;
  flex: 0 0 auto;
}
.h-body {
  flex: 1;
  padding-left: 24rpx;
}
.h-name {
  font-size: calc(32rpx * var(--fs));
  font-weight: 600;
  color: #221d18;
}
.habit.done .h-name {
  color: #b08975;
}
.h-streak {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--fs));
  color: #a89e8f;
}
.h-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid #e6ded2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(32rpx * var(--fs));
  color: #ffffff;
  flex: 0 0 auto;
}
.h-check.on {
  background: #e8674a;
  border-color: #e8674a;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 90rpx 0;
}
.empty-t {
  font-size: calc(32rpx * var(--fs));
  color: #221d18;
}
.empty-s {
  margin-top: 12rpx;
  font-size: calc(23rpx * var(--fs));
  color: #a89e8f;
}
.empty-btn {
  display: inline-block;
  margin-top: 36rpx;
  padding: 22rpx 60rpx;
  background: #e8674a;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: calc(27rpx * var(--fs));
}

.tip {
  margin-top: 20rpx;
  font-size: calc(21rpx * var(--fs));
  color: #b8ad9d;
  text-align: center;
}

/* 计时打卡 */
.habit.timing {
  border: 2rpx solid #e8674a;
}

.timer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(34, 29, 24, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.timer-card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 32rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.timer-ring {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.timer-ring-in {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.timer-clock {
  font-size: calc(64rpx * var(--fs));
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #221d18;
}
.timer-target {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--fs));
  color: #a89e8f;
}
.timer-name {
  margin-top: 26rpx;
  font-size: calc(30rpx * var(--fs));
  color: #221d18;
}
.timer-actions {
  display: flex;
  margin-top: 30rpx;
}
.t-btn {
  width: 156rpx;
  height: 84rpx;
  margin: 0 8rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(27rpx * var(--fs));
}
.t-btn.ghost2 {
  background: #f1e9df;
  color: #6f6559;
}
.timer-state {
  margin-top: 10rpx;
  font-size: calc(21rpx * var(--fs));
  color: #b8ad9d;
}
.theme-dark .t-btn.ghost2 {
  background: #3A3A3C;
  color: #F2F2F7;
}
.theme-dark .timer-state {
  color: #8E8E93;
}
.t-btn.ghost {
  background: #faf7f2;
  color: #8a8073;
}
.t-btn.ok {
  background: #e8674a;
  color: #ffffff;
}
.t-btn.wait {
  background: #f1e9df;
  color: #b8ad9d;
}

/* AI 指令 */
.ai-bar {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
}
.ai-bar-input {
  flex: 1;
  height: 64rpx;
  font-size: calc(25rpx * var(--fs));
  color: #221d18;
}
.ai-bar-btn {
  width: 108rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #4a7ab5;
  color: #ffffff;
  font-size: calc(24rpx * var(--fs));
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-bar-btn.busy {
  background: #b9c8db;
}
.ai-reply {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: calc(23rpx * var(--fs));
  line-height: 1.6;
  color: #4a9e6f;
}

