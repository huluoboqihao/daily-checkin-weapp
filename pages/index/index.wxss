/* ── 过期待办 / 优先级 ───────────────────────── */
.task.overdue {
  border-left: 6rpx solid #FF9F0A;
}
.t-today {
  margin-left: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #FFF6E5;
  color: #B26A00;
  font-size: calc(20rpx * var(--fs));
  flex: none;
}
.t-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
}
.t-dot.p1 {
  background: #8E8E93;
}
.t-dot.p3 {
  background: #FF3B30;
}
.edit-input.half {
  flex: 1;
  height: 76rpx;
  margin-right: 12rpx;
}
.edit-input.half:last-child {
  margin-right: 0;
}
.pri-row {
  align-items: center;
}
.edit-lbl {
  font-size: calc(23rpx * var(--fs));
  color: #8E8E93;
  margin-right: 14rpx;
}
.pri {
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #F2F2F7;
  font-size: calc(24rpx * var(--fs));
  color: #8E8E93;
}
.pri.on {
  background: #1C1C1E;
  color: #FFFFFF;
}
.theme-dark .t-today {
  background: rgba(178, 106, 0, 0.25);
  color: #FFB340;
}
.theme-dark .edit-lbl {
  color: #8E8E93;
}
.theme-dark .pri {
  background: #2C2C2E;
  color: #8E8E93;
}
.theme-dark .pri.on {
  background: #F2F2F7;
  color: #1C1C1E;
}

/* 新建待办 / 转习惯 */
.new-task {
  margin: 6rpx 0 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(60, 60, 67, 0.22);
  text-align: center;
  font-size: calc(24rpx * var(--fs));
  color: #8E8E93;
}
.to-habit {
  margin-top: 22rpx;
  text-align: center;
  font-size: calc(23rpx * var(--fs));
  color: #FF6B4A;
  padding: 12rpx 0;
}
.theme-dark .new-task {
  border-color: rgba(235, 235, 245, 0.24);
  color: #8E8E93;
}
.habit.just-done {
  animation: pop 0.3s ease;
}
.h-note {
  margin-top: 6rpx;
  font-size: calc(21rpx * var(--fs));
  line-height: 1.45;
  color: #B26A00;
}
.note-input {
  width: 100%;
  min-height: 150rpx;
  background: #F2F2F7;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: calc(27rpx * var(--fs));
  color: #1C1C1E;
  box-sizing: border-box;
}
.theme-dark .h-note {
  color: #FFB340;
}
.theme-dark .note-input {
  background: #2C2C2E;
  color: #F2F2F7;
}
.theme-dark .to-habit {
  color: #FF8A66;
}

/* AI 功能面板 */
.ai-more {
  width: 48rpx;
  text-align: center;
  color: #8E8E93;
  font-size: calc(30rpx * var(--fs));
  margin-right: 6rpx;
  flex: none;
}
.ai-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.42);
  z-index: 60;
}
.ai-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.ai-sheet-t {
  text-align: center;
  font-size: calc(23rpx * var(--fs));
  color: #8E8E93;
  padding: 10rpx 0 18rpx;
}
.ai-opt {
  display: flex;
  align-items: center;
  padding: 24rpx 18rpx;
  border-radius: 20rpx;
}
.ai-opt:active {
  background: #F2F2F7;
}
.ai-opt-i {
  font-size: calc(32rpx * var(--fs));
  margin-right: 18rpx;
}
.ai-opt-t {
  font-size: calc(28rpx * var(--fs));
  color: #1C1C1E;
}
.ai-cancel {
  margin-top: 14rpx;
  text-align: center;
  padding: 22rpx;
  font-size: calc(26rpx * var(--fs));
  color: #8E8E93;
  border-top: 1rpx solid rgba(60, 60, 67, 0.12);
}
.theme-dark .ai-sheet {
  background: #1C1C1E;
}
.theme-dark .ai-opt:active {
  background: #2C2C2E;
}
.theme-dark .ai-opt-t {
  color: #F2F2F7;
}
.theme-dark .ai-cancel {
  color: #8E8E93;
  border-top-color: rgba(84, 84, 88, 0.65);
}

/* ── 新手引导 ───────────────────────────────── */
.guide {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx;
  margin-top: 14rpx;
}
.guide-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.guide-t {
  flex: 1;
  font-size: calc(27rpx * var(--fs));
  font-weight: 700;
  color: #1C1C1E;
}
.guide-x {
  font-size: calc(24rpx * var(--fs));
  color: #C7C7CC;
  padding: 6rpx 10rpx;
}
.guide-item {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}
.guide-n {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #FF6B4A;
  color: #FFFFFF;
  font-size: calc(19rpx * var(--fs));
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 14rpx;
  margin-top: 2rpx;
}
.guide-d {
  flex: 1;
  font-size: calc(23rpx * var(--fs));
  line-height: 1.55;
  color: #8E8E93;
}
.guide-btn {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #F2F2F7;
  color: #FF6B4A;
  font-size: calc(25rpx * var(--fs));
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-dark .guide {
  background: #1C1C1E;
}
.theme-dark .guide-t {
  color: #F2F2F7;
}
.theme-dark .guide-d,
.theme-dark .guide-x {
  color: #8E8E93;
}
.theme-dark .guide-btn {
  background: #2C2C2E;
  color: #FF8A66;
}
