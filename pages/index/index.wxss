  padding: 14rpx 14rpx 14rpx 26rpx;
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.ai-top {
  margin-top: 16rpx;
  margin-bottom: 4rpx;
}
.ai-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #1C1C1E;
  color: #FFFFFF;
  font-size: calc(20rpx * var(--fs));
  font-weight: 700;
  display: flex;
  align-items: center;
