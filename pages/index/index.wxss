/* 今日待办 */
.task {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx;
  margin-bottom: 14rpx;
}
.t-time {
  width: 104rpx;
  padding-top: 4rpx;
  font-size: calc(24rpx * var(--fs));
  font-weight: 600;
  color: #8E8E93;
}
.t-body {
  flex: 1;
}
.t-title {
  font-size: calc(30rpx * var(--fs));
  font-weight: 600;
  color: #1C1C1E;
}
.task.done .t-title {
  color: #C7C7CC;
  text-decoration: line-through;
}
.t-sub {
  margin-top: 6rpx;
  font-size: calc(22rpx * var(--fs));
  color: #8E8E93;
}
.t-conflict {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: calc(20rpx * var(--fs));
}
.t-conflict.high {
  background: #FFEBE7;
  color: #D70015;
}
.t-conflict.warn {
  background: #FFF6E5;
  color: #B26A00;
}
.t-check {
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  border: 3rpx solid #E5E5EA;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs));
  color: #FFFFFF;
}
.t-check.on {
  background: #34C759;
  border-color: #34C759;
}

.import-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 14rpx;
}
.ir-t {
  flex: 1;
  font-size: calc(25rpx * var(--fs));
  color: #8E8E93;
}
.ir-a {
  font-size: calc(32rpx * var(--fs));
  color: #C7C7CC;
}

/* AI 总入口：放在 hero 右上角，避免悬浮球挡住勾选 */
.ai-pill {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  z-index: 2;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(28, 28, 30, 0.06);
  color: #1C1C1E;
  font-size: calc(22rpx * var(--fs));
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 待办编辑 */
.edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 16, 12, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 30;
}
.edit-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.edit-h {
  font-size: calc(30rpx * var(--fs));
  font-weight: 700;
  margin-bottom: 20rpx;
}
.edit-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #F2F2F7;
  border-radius: 20rpx;
  font-size: calc(30rpx * var(--fs));
  color: #1C1C1E;
}
.edit-row {
  display: flex;
  margin-top: 16rpx;
}
.edit-chip {
  padding: 16rpx 26rpx;
  margin-right: 14rpx;
  background: #F2F2F7;
  border-radius: 18rpx;
  font-size: calc(25rpx * var(--fs));
  color: #1C1C1E;
}
.edit-actions {
  display: flex;
  margin-top: 26rpx;
}
.e-btn {
  flex: 1;
  height: 84rpx;
  margin-right: 14rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(27rpx * var(--fs));
}
.e-btn:last-child {
  margin-right: 0;
}
.e-btn.danger {
  background: #FFEBE7;
  color: #D70015;
}
.e-btn.ghost {
  background: #F2F2F7;
  color: #8E8E93;
}
.e-btn.main {
  background: #FF6B4A;
  color: #FFFFFF;
  font-weight: 600;
}

/* 断签救援 */
.rescue {
  display: flex;
  align-items: center;
  background: #1C1C1E;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  margin-top: 14rpx;
}
.rs-main {
  flex: 1;
  padding-right: 16rpx;
}
.rs-title {
  font-size: calc(22rpx * var(--fs));
  letter-spacing: 2rpx;
  color: #FFB3A0;
}
.rs-msg {
  margin-top: 6rpx;
  font-size: calc(25rpx * var(--fs));
  line-height: 1.5;
  color: #FFFFFF;
}
.rs-btn {
  padding: 14rpx 26rpx;
  border-radius: 22rpx;
  background: #FF6B4A;
  color: #FFFFFF;
  font-size: calc(24rpx * var(--fs));
  font-weight: 600;
}
.rs-close {
  margin-left: 16rpx;
  font-size: calc(24rpx * var(--fs));
  color: rgba(255, 255, 255, 0.45);
  padding: 6rpx;
}

/* 生成素材：hero 背景与空状态插画 */
.hero {
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.26;
}
.hero-date,
.hero-mid,
.bar,
.cum,
.cum-note {
  position: relative;
  z-index: 1;
}

.empty-art {
  width: 360rpx;
  height: 270rpx;
  margin-bottom: 8rpx;
  opacity: 0.95;
}

.empty {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 24rpx 56rpx;
  margin-top: 12rpx;
}

/* 显示偏好 */
.display-row {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}
.display-btn {
  margin: 0 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(28, 28, 30, 0.05);
  font-size: calc(21rpx * var(--fs));
  color: #8E8E93;
}

/* ── 深色模式 ───────────────────────────────── */
.theme-dark .hero-date,
.theme-dark .prog-l,
.theme-dark .cum,
